<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Only committed history, including AtomicFile's recovery copy on older Android.
         Android 9+ requires client-side encryption for cloud backup, or direct transfer.
         Android 7/8 ignore requireFlags; their system backup protection applies. -->
    <include domain="file" path="transcripts/transcript-history.json"
        requireFlags="clientSideEncryption|deviceToDeviceTransfer" />
    <include domain="file" path="transcripts/transcript-history.json.bak"
        requireFlags="clientSideEncryption|deviceToDeviceTransfer" />
</full-backup-content>
